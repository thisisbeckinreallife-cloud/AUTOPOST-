# Archivos que NO deben entrar al Docker context.
# Reduce build time (menos transfer) y tamaño de imagen.

# Build artifacts
node_modules
.next
out
dist
build

# Git
.git
.gitignore

# Env (los secrets entran via Railway env, NO copiados a la imagen)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude / agentic stuff
.claude
.claude-cache
CLAUDE.md
*.lessons.md

# Docs y branding (no usado en runtime)
docs
branding-redesign
README.md
*.md
!prisma/migrations/**/README.md

# Tests
coverage
.nyc_output
*.test.ts
*.spec.ts
__tests__

# Misc
tasks
graphify-out
*.html
!src/**/*.html
