# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
DATABASE_URL="postgresql://autopost:autopost@localhost:5432/autopost"

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────
# STORAGE (S3-compatible: AWS S3, MinIO, Cloudflare R2, etc.)
# ─────────────────────────────────────────
STORAGE_ENDPOINT="http://localhost:9000"          # Omit for AWS S3
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_BUCKET="autopost"
STORAGE_REGION="us-east-1"
STORAGE_PUBLIC_URL="http://localhost:9000/autopost" # Base URL for public assets

# ─────────────────────────────────────────
# AUTH (admin session)
# ─────────────────────────────────────────
SESSION_SECRET="change-me-to-a-random-64-char-string-in-production"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""   # Generated by: tsx scripts/hash-password.ts <password>

# ─────────────────────────────────────────
# ENCRYPTION (for Meta tokens stored in DB)
# ─────────────────────────────────────────
ENCRYPTION_KEY="32-byte-hex-string-change-in-prod"  # 64 hex chars = 32 bytes

# ─────────────────────────────────────────
# META / FACEBOOK APP
# See README.md §"Meta App Setup" for full instructions.
# These are obtained from https://developers.facebook.com/apps
# ─────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/meta/oauth/callback"
# Required scopes: instagram_basic,instagram_content_publish,pages_show_list,
#                  pages_read_engagement,business_management

# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─────────────────────────────────────────
# ANTHROPIC — captions con voz de marca
# Modelo: Claude Sonnet 4.5 con prompt caching agresivo.
# Sin la key, /api/ai/caption devuelve 503.
# Obtén una key en https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─────────────────────────────────────────
# OPENAI — chat IA editorial principal (gpt-4o-mini)
# Si está configurada, el chat usa OpenAI gpt-4o-mini (más barato y
# tool calling más fiable que Llama 3.3 en Together).
# Sin esta key, fallback automático a TOGETHER_API_KEY.
# Obtén una key en https://platform.openai.com/api-keys
# ─────────────────────────────────────────
OPENAI_API_KEY=""

# ─────────────────────────────────────────
# TOGETHER.AI — fallback chat + hashtags + análisis vision de carpetas
# El chat la usa solo si OPENAI_API_KEY no está. Hashtags y vision (Llama
# Vision 90B) la usan siempre.
# Sin la key, las features que la requieren devuelven 503.
# Obtén una key en https://api.together.ai/settings/api-keys
# ─────────────────────────────────────────
TOGETHER_API_KEY=""

# ─────────────────────────────────────────
# MULTI-PLATAFORMA OAUTH (Sprint 3)
# Cada plataforma necesita developer app + credenciales.
# Sin las keys, la card de cada plataforma muestra "próximamente" y
# el OAuth start devuelve 503 limpio.
#
# *_PRODUCTION_MODE — flag por plataforma. Mientras está en "0",
# la app developer está en test mode (review pendiente) y solo los
# emails añadidos manualmente como testers en el dashboard del provider
# pueden completar OAuth. La UI muestra "Beta · sólo testers invitados".
# Cuando review aprueba, flippeas a "1" y se muestra "Conectar" normal.
# ─────────────────────────────────────────

# TikTok — requiere App Review (1-2 sem)
# https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_PRODUCTION_MODE="0"

# LinkedIn — disponible inmediatamente
# https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_PRODUCTION_MODE="0"

# Google (YouTube Shorts) — pedir aumento quota desde inicio
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YOUTUBE_PRODUCTION_MODE="0"

# Pinterest — disponible inmediatamente
# https://developers.pinterest.com/apps
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
PINTEREST_PRODUCTION_MODE="0"

# ─────────────────────────────────────────
# SCHEDULER
# ─────────────────────────────────────────
# How many minutes before scheduled time to enqueue job
SCHEDULER_LEAD_MINUTES="5"
# Max concurrent publish workers
WORKER_CONCURRENCY="3"

# ─────────────────────────────────────────
# EMAIL NOTIFICATIONS (optional)
# Leave SMTP_HOST empty to disable email notifications.
# ─────────────────────────────────────────
SMTP_HOST=""                              # e.g. smtp.sendgrid.net or smtp.gmail.com
SMTP_PORT="587"                           # 587 (TLS) or 465 (SSL)
SMTP_USER=""                              # SMTP username / API key
SMTP_PASS=""                              # SMTP password
SMTP_FROM="AutoPost <noreply@autopost.app>"
NOTIFY_EMAIL=""                           # Where to receive publish/fail alerts

# ════════════════════════════════════════════════════════════════
# STRIPE — pricing semanal con trial 7 días
# Ver docs/stripe-setup.md para el setup paso a paso.
# ════════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs — crear 6 prices en Stripe Dashboard (3 tiers × 2 periodos)
# Currency: EUR. Recurring weekly o yearly según el sufijo.
STRIPE_PRICE_BASIC_WEEKLY=""
STRIPE_PRICE_BASIC_YEARLY=""
STRIPE_PRICE_PRO_WEEKLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_AGENCY_WEEKLY=""
STRIPE_PRICE_AGENCY_YEARLY=""
