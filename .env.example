# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
DATABASE_URL="postgresql://autopost:autopost@localhost:5432/autopost"

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────
# STORAGE (S3-compatible: AWS S3, MinIO, Cloudflare R2, etc.)
# ─────────────────────────────────────────
STORAGE_ENDPOINT="http://localhost:9000"          # Omit for AWS S3
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_BUCKET="autopost"
STORAGE_REGION="us-east-1"
STORAGE_PUBLIC_URL="http://localhost:9000/autopost" # Base URL for public assets

# ─────────────────────────────────────────
# AUTH (admin session)
# ─────────────────────────────────────────
SESSION_SECRET="change-me-to-a-random-64-char-string-in-production"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""   # Generated by: tsx scripts/hash-password.ts <password>

# ─────────────────────────────────────────
# ENCRYPTION (for Meta tokens stored in DB)
# ─────────────────────────────────────────
ENCRYPTION_KEY="32-byte-hex-string-change-in-prod"  # 64 hex chars = 32 bytes

# ─────────────────────────────────────────
# META / FACEBOOK APP
# See README.md §"Meta App Setup" for full instructions.
# These are obtained from https://developers.facebook.com/apps
# ─────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/meta/oauth/callback"
# Required scopes: instagram_basic,instagram_content_publish,pages_show_list,
#                  pages_read_engagement,business_management

# ─────────────────────────────────────────
# APP
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─────────────────────────────────────────
# SCHEDULER
# ─────────────────────────────────────────
# How many minutes before scheduled time to enqueue job
SCHEDULER_LEAD_MINUTES="5"
# Max concurrent publish workers
WORKER_CONCURRENCY="3"
