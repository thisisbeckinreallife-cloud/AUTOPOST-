{
  "name": "autopost",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && cp -R .next/static .next/standalone/.next/ 2>/dev/null; cp -R public .next/standalone/ 2>/dev/null; mkdir -p .next/standalone/src/messages 2>/dev/null; cp -R src/messages/. .next/standalone/src/messages/ 2>/dev/null; true",
    "start": "node scripts/start.js",
    "worker": "tsx --watch src/workers/publish.worker.ts",
    "worker:once": "tsx src/workers/publish.worker.ts",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && tsx scripts/seed.ts",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "deploy:status": "bash scripts/deploy-status.sh",
    "deploy:smoke": "bash scripts/smoke-test.sh",
    "deploy:logs": "railway logs --deployment $(railway status --json | python3 -c \"import sys,json; print(json.load(sys.stdin)['environments']['edges'][0]['node']['serviceInstances']['edges'][0]['node']['latestDeployment']['id'])\") --lines 100"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/lib-storage": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@prisma/client": "^5.11.0",
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.15.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.0",
    "@types/three": "^0.162.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.7.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "form-data": "^4.0.0",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.3.2",
    "iron-session": "^8.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.372.0",
    "maath": "^0.10.7",
    "next": "^14.2.35",
    "next-intl": "^4.11.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "openai": "^6.35.0",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.33.3",
    "stripe": "^22.1.1",
    "tailwind-merge": "^2.2.2",
    "three": "^0.162.0",
    "together-ai": "^0.39.0",
    "tsx": "^4.7.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "prisma": "^5.11.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
