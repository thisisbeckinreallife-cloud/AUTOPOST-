generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ADMIN USER
// ─────────────────────────────────────────
model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  emailVerified   Boolean   @default(false)
  resetToken      String?   @unique
  resetTokenExp   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Plan tier — sin créditos, solo metadata para gating de features.
  // Stripe gestiona la facturación semanal aparte.
  plan          String    @default("FREE")  // FREE | SOLO | PRO | AGENCY
  planExpiresAt DateTime?
  // ID de Stripe customer/subscription para webhook lookups
  stripeCustomerId      String? @unique
  stripeSubscriptionId  String? @unique

  auditLogs AuditLog[]
  chats     AiChat[]

  @@map("admin_users")
}

// ─────────────────────────────────────────
// BUSINESS
// ─────────────────────────────────────────
model Business {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  timezone    String  @default("UTC") // e.g. "Europe/Madrid"
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metaConnection    MetaConnection?
  uploadBatches     UploadBatch[]
  postDrafts        PostDraft[]
  auditLogs         AuditLog[]
  reports           Report[]
  brandProfile      BrandProfile?
  socialConnections SocialConnection[]

  @@map("businesses")
}

// ─────────────────────────────────────────
// META CONNECTION
// ─────────────────────────────────────────
model MetaConnection {
  id         String @id @default(cuid())
  businessId String @unique

  // Instagram-specific identifiers
  igUserId      String  // Instagram user ID (numeric string)
  igUsername    String
  fbPageId      String? // Facebook Page ID linked to the IG account
  fbPageName    String?

  // Tokens — encrypted at rest using AES-256-GCM via lib/crypto.ts
  // NEVER expose these fields to the frontend
  accessTokenEnc  String  // Encrypted long-lived user access token
  accessTokenIv   String  // IV for decryption
  accessTokenTag  String  // Auth tag for AES-GCM

  pageTokenEnc    String? // Encrypted page access token (for some API calls)
  pageTokenIv     String?
  pageTokenTag    String?

  tokenExpiresAt  DateTime?
  status          MetaConnectionStatus @default(ACTIVE)
  lastCheckedAt   DateTime?
  lastError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("meta_connections")
}

enum MetaConnectionStatus {
  PENDING
  ACTIVE
  TOKEN_EXPIRED
  REVOKED
  ERROR
}

// ─────────────────────────────────────────
// UPLOAD BATCH
// ─────────────────────────────────────────
model UploadBatch {
  id         String @id @default(cuid())
  businessId String

  originalFilename String
  storagePath      String  // Path in S3/storage
  fileSize         Int
  fileHash         String  // SHA-256 of zip to prevent reprocessing
  status           BatchStatus @default(UPLOADED)

  parsedAt     DateTime?
  confirmedAt  DateTime?
  scheduledAt  DateTime?

  parseErrors  Json?    // Array of ParseError
  parseWarnings Json?   // Array of ParseWarning
  totalPosts   Int?
  validPosts   Int?
  failedPosts  Int?

  uploadedByIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  postDrafts PostDraft[]

  @@map("upload_batches")
}

enum BatchStatus {
  UPLOADED
  PARSING
  PARSED
  VALIDATION_FAILED
  READY
  PARTIALLY_SCHEDULED
  SCHEDULED
  FAILED
}

// ─────────────────────────────────────────
// POST DRAFT
// ─────────────────────────────────────────
model PostDraft {
  id         String @id @default(cuid())
  businessId String
  batchId    String

  // From meta.json
  postType    PostType
  publishAt   DateTime
  timezone    String
  firstComment String?
  locationId  String?
  collaborators Json?    // JSON array of Instagram usernames, max 3

  // Content
  caption      String
  captionHash  String  // SHA-256 of caption

  // Deduplication
  contentHash  String  // SHA-256(caption + sorted asset hashes)
  idempotencyKey String @unique @default(cuid())

  // State
  status       PostDraftStatus @default(DRAFT)
  validationErrors Json?        // Array of ValidationError
  scheduledJobId   String?      // BullMQ job ID

  // Approval workflow (optional — enabled via SystemConfig key "approval_required")
  approvalStatus  ApprovalStatus @default(APPROVED)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  // Meta API results
  metaContainerId   String?
  metaPublicationId String?
  metaPermalink     String?
  lastMetaResponse  Json?
  lastError         String?

  publishedAt     DateTime?
  failedAt        DateTime?
  attemptCount    Int      @default(0)

  // Source info
  sourceFolderName String  // e.g. "2026-04-15_post-01"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  batch            UploadBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  mediaAssets      MediaAsset[]
  publishJobs      PublishJob[]
  approvalRequests ApprovalRequest[]
  socialPublications SocialPublication[]

  @@unique([businessId, contentHash])
  @@map("post_drafts")
}

enum PostDraftStatus {
  DRAFT
  VALIDATED
  READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum PostType {
  IMAGE
  CAROUSEL
  REEL
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────
// MEDIA ASSET
// ─────────────────────────────────────────
model MediaAsset {
  id          String @id @default(cuid())
  postDraftId String

  originalFilename String
  storagePath      String
  storageUrl       String  // Full URL (pre-signed or public)
  mimeType         String
  fileSize         Int
  fileHash         String  // SHA-256

  // For video/image metadata
  width       Int?
  height      Int?
  durationSec Float?

  sortOrder   Int    @default(0)

  // Meta upload state
  metaUploadHandle String?  // For resumable uploads
  uploadedToMeta   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postDraft PostDraft @relation(fields: [postDraftId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

// ─────────────────────────────────────────
// PUBLISH JOB
// ─────────────────────────────────────────
model PublishJob {
  id          String @id @default(cuid())
  postDraftId String
  businessId  String

  bullmqJobId    String? @unique
  status         JobStatus @default(PENDING)
  scheduledFor   DateTime
  lockedUntil    DateTime?  // Optimistic lock to prevent double execution

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  postDraft  PostDraft       @relation(fields: [postDraftId], references: [id], onDelete: Cascade)
  attempts   PublishAttempt[]

  @@map("publish_jobs")
}

enum JobStatus {
  PENDING
  ENQUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────
// PUBLISH ATTEMPT
// ─────────────────────────────────────────
model PublishAttempt {
  id           String @id @default(cuid())
  publishJobId String

  attemptNumber Int
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  success       Boolean?
  errorCode     String?
  errorMessage  String?
  metaResponse  Json?    // Summarized Meta API response

  @@map("publish_attempts")

  publishJob PublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────
model AuditLog {
  id          String @id @default(cuid())
  businessId  String?
  adminUserId String?

  action      String  // e.g. "BATCH_UPLOADED", "POST_PUBLISHED", "TOKEN_REFRESHED"
  entityType  String? // e.g. "PostDraft", "UploadBatch"
  entityId    String?
  detail      Json?
  ipAddress   String?

  createdAt   DateTime @default(now())

  business   Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  adminUser  AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─────────────────────────────────────────
// REPORT
// Informe editorial imprimible (print-to-PDF) de un periodo de un negocio.
// El admin genera el report → snapshot KPIs + lista de posts publicados
// → URL pública /informe/[token] con CSS @media print, lista para Cmd+P.
// El token expira por defecto a los 30 días (renovable).
// ─────────────────────────────────────────
model Report {
  id         String   @id @default(cuid())
  businessId String
  token      String   @unique

  periodStart DateTime
  periodEnd   DateTime
  expiresAt   DateTime

  // Snapshot al momento de generar — para que el informe sea estable aunque
  // los posts cambien de estado luego.
  totalScheduled  Int
  totalPublished  Int
  totalFailed     Int
  successRate     Float
  // Detalle por día y por tipo guardado como JSON para evitar joins extra
  // al renderizar.
  daily      Json   // [{date, published, scheduled, failed}]
  byType     Json   // {IMAGE: n, CAROUSEL: n, REEL: n}
  topPosts   Json   // [{id, caption, type, publishedAt, permalink}]

  // Para reportes accedidos desde un front anónimo que cuenta accesos.
  viewCount  Int    @default(0)
  lastViewedAt DateTime?

  createdAt DateTime @default(now())
  createdByAdminUserId String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([token])
  @@map("reports")
}

// ─────────────────────────────────────────
// APPROVAL REQUEST (magic-link)
// Permite que un cliente apruebe/rechace un post desde un enlace mágico
// recibido por email, sin necesidad de iniciar sesión. El token es de un
// solo uso, expira en N horas (default 72) y se enlaza a un PostDraft.
// ─────────────────────────────────────────
model ApprovalRequest {
  id          String   @id @default(cuid())
  postDraftId String
  token       String   @unique
  email       String   // Email del cliente que debe aprobar

  expiresAt   DateTime
  respondedAt DateTime?
  decision    ApprovalDecision?
  feedback    String?  // Mensaje opcional del cliente (max 1000 chars)
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())
  createdByAdminUserId String?

  postDraft   PostDraft @relation(fields: [postDraftId], references: [id], onDelete: Cascade)

  @@index([postDraftId, createdAt])
  @@index([token])
  @@map("approval_requests")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────
// SOCIAL CONNECTION (multi-plataforma post-pivot)
// 1:1 con (Business, SocialPlatform). Almacena tokens encrypted con
// AES-256-GCM (mismo patrón que MetaConnection).
// MetaConnection se mantiene como legacy para Instagram + Facebook que ya
// funcionan; las nuevas plataformas usan SocialConnection unificada.
// ─────────────────────────────────────────
model SocialConnection {
  id         String         @id @default(cuid())
  businessId String
  platform   SocialPlatform

  externalUserId      String   // tiktok_open_id | linkedin_urn | youtube_channel_id
  externalUsername    String?
  externalDisplayName String?

  // Tokens encrypted (AES-256-GCM)
  accessTokenEnc  String
  accessTokenIv   String
  accessTokenTag  String
  refreshTokenEnc String?
  refreshTokenIv  String?
  refreshTokenTag String?

  scopes        String[]
  expiresAt     DateTime?
  status        ConnectionStatus @default(ACTIVE)
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  publications SocialPublication[]

  @@unique([businessId, platform])
  @@map("social_connections")
}

enum SocialPlatform {
  TIKTOK
  LINKEDIN
  YOUTUBE
  PINTEREST
}

enum ConnectionStatus {
  ACTIVE
  TOKEN_EXPIRED
  REVOKED
  ERROR
}

// ─────────────────────────────────────────
// SOCIAL PUBLICATION (per-platform publish state)
// 1:N con PostDraft. Permite ver "publicado en TikTok ✓ LinkedIn fail".
// Los posts a Instagram + Facebook siguen usando los campos legacy
// del PostDraft (metaPublicationId, metaPermalink) hasta migración futura.
// ─────────────────────────────────────────
model SocialPublication {
  id           String         @id @default(cuid())
  postDraftId  String
  connectionId String
  platform     SocialPlatform

  externalPostId    String?
  externalPermalink String?
  status            PublishStatus @default(PENDING)
  publishedAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postDraft  PostDraft        @relation(fields: [postDraftId], references: [id], onDelete: Cascade)
  connection SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([postDraftId])
  @@index([status, createdAt])
  @@map("social_publications")
}

enum PublishStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

// ─────────────────────────────────────────
// BRAND PROFILE (simplificado post-pivot)
// 1:1 con Business. Datos básicos de la marca para enriquecer el chat IA.
// Sin niveles L1-L5, sin LoRAs, sin voice training. Solo metadata simple
// que el user actualiza conversacionalmente desde el chat o el panel.
// ─────────────────────────────────────────
model BrandProfile {
  id         String   @id @default(cuid())
  businessId String   @unique

  niche             String?       // "gastronomia" | "moda" | "fitness" | etc
  tone              String?       // descripción libre del tono
  targetAudience    String?       // a quién le habla
  taboos            Json?         // frases/palabras a evitar
  preferredPostingDays Json?      // ["mon", "wed", "fri"]
  preferredPlatforms Json?        // ["instagram", "tiktok"]
  notes             String?       // notas libres del user

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

// ─────────────────────────────────────────
// AI CHAT
// Sesión de chat conversacional entre user y la IA editorial.
// Cada chat puede estar vinculado a un business + opcionalmente a un batch
// específico. Persiste para que el user pueda volver a la conversación.
// ─────────────────────────────────────────
model AiChat {
  id          String   @id @default(cuid())
  adminUserId String
  businessId  String?
  batchId     String?  // opcional: chat sobre un batch específico

  title       String?
  totalTokens Int      @default(0)
  totalCostUsd Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]

  @@index([adminUserId, createdAt])
  @@index([businessId, createdAt])
  @@map("ai_chats")
}

model AiChatMessage {
  id        String   @id @default(cuid())
  chatId    String

  role      String   // "user" | "assistant" | "tool"
  content   String   // texto plano del mensaje
  toolCalls Json?    // [{name, input, output}] cuando assistant invoca tools
  attachments Json?  // URLs de imágenes adjuntas, archivos, etc.

  createdAt DateTime @default(now())

  chat AiChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("ai_chat_messages")
}

// ─────────────────────────────────────────
// SYSTEM CONFIG
// Platform-level settings (Meta App credentials, etc.)
// Sensitive values are encrypted with AES-256-GCM.
// ─────────────────────────────────────────
model SystemConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String? // Plain text for non-sensitive values
  valueEnc    String? // Encrypted ciphertext
  valueIv     String? // AES-GCM IV
  valueTag    String? // AES-GCM auth tag
  isEncrypted Boolean @default(false)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}
