generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ADMIN USER
// ─────────────────────────────────────────
model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  emailVerified   Boolean   @default(false)
  resetToken      String?   @unique
  resetTokenExp   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("admin_users")
}

// ─────────────────────────────────────────
// BUSINESS
// ─────────────────────────────────────────
model Business {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  timezone    String  @default("UTC") // e.g. "Europe/Madrid"
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metaConnection MetaConnection?
  uploadBatches  UploadBatch[]
  postDrafts     PostDraft[]
  auditLogs      AuditLog[]
  aiUsage        AiUsage[]
  reports        Report[]

  @@map("businesses")
}

// ─────────────────────────────────────────
// META CONNECTION
// ─────────────────────────────────────────
model MetaConnection {
  id         String @id @default(cuid())
  businessId String @unique

  // Instagram-specific identifiers
  igUserId      String  // Instagram user ID (numeric string)
  igUsername    String
  fbPageId      String? // Facebook Page ID linked to the IG account
  fbPageName    String?

  // Tokens — encrypted at rest using AES-256-GCM via lib/crypto.ts
  // NEVER expose these fields to the frontend
  accessTokenEnc  String  // Encrypted long-lived user access token
  accessTokenIv   String  // IV for decryption
  accessTokenTag  String  // Auth tag for AES-GCM

  pageTokenEnc    String? // Encrypted page access token (for some API calls)
  pageTokenIv     String?
  pageTokenTag    String?

  tokenExpiresAt  DateTime?
  status          MetaConnectionStatus @default(ACTIVE)
  lastCheckedAt   DateTime?
  lastError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("meta_connections")
}

enum MetaConnectionStatus {
  PENDING
  ACTIVE
  TOKEN_EXPIRED
  REVOKED
  ERROR
}

// ─────────────────────────────────────────
// UPLOAD BATCH
// ─────────────────────────────────────────
model UploadBatch {
  id         String @id @default(cuid())
  businessId String

  originalFilename String
  storagePath      String  // Path in S3/storage
  fileSize         Int
  fileHash         String  // SHA-256 of zip to prevent reprocessing
  status           BatchStatus @default(UPLOADED)

  parsedAt     DateTime?
  confirmedAt  DateTime?
  scheduledAt  DateTime?

  parseErrors  Json?    // Array of ParseError
  parseWarnings Json?   // Array of ParseWarning
  totalPosts   Int?
  validPosts   Int?
  failedPosts  Int?

  uploadedByIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  postDrafts PostDraft[]

  @@map("upload_batches")
}

enum BatchStatus {
  UPLOADED
  PARSING
  PARSED
  VALIDATION_FAILED
  READY
  PARTIALLY_SCHEDULED
  SCHEDULED
  FAILED
}

// ─────────────────────────────────────────
// POST DRAFT
// ─────────────────────────────────────────
model PostDraft {
  id         String @id @default(cuid())
  businessId String
  batchId    String

  // From meta.json
  postType    PostType
  publishAt   DateTime
  timezone    String
  firstComment String?
  locationId  String?
  collaborators Json?    // JSON array of Instagram usernames, max 3

  // Content
  caption      String
  captionHash  String  // SHA-256 of caption

  // Deduplication
  contentHash  String  // SHA-256(caption + sorted asset hashes)
  idempotencyKey String @unique @default(cuid())

  // State
  status       PostDraftStatus @default(DRAFT)
  validationErrors Json?        // Array of ValidationError
  scheduledJobId   String?      // BullMQ job ID

  // Approval workflow (optional — enabled via SystemConfig key "approval_required")
  approvalStatus  ApprovalStatus @default(APPROVED)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  // Meta API results
  metaContainerId   String?
  metaPublicationId String?
  metaPermalink     String?
  lastMetaResponse  Json?
  lastError         String?

  publishedAt     DateTime?
  failedAt        DateTime?
  attemptCount    Int      @default(0)

  // Source info
  sourceFolderName String  // e.g. "2026-04-15_post-01"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  batch         UploadBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  mediaAssets   MediaAsset[]
  publishJobs   PublishJob[]
  approvalRequests ApprovalRequest[]

  @@unique([businessId, contentHash])
  @@map("post_drafts")
}

enum PostDraftStatus {
  DRAFT
  VALIDATED
  READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum PostType {
  IMAGE
  CAROUSEL
  REEL
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────
// MEDIA ASSET
// ─────────────────────────────────────────
model MediaAsset {
  id          String @id @default(cuid())
  postDraftId String

  originalFilename String
  storagePath      String
  storageUrl       String  // Full URL (pre-signed or public)
  mimeType         String
  fileSize         Int
  fileHash         String  // SHA-256

  // For video/image metadata
  width       Int?
  height      Int?
  durationSec Float?

  sortOrder   Int    @default(0)

  // Meta upload state
  metaUploadHandle String?  // For resumable uploads
  uploadedToMeta   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postDraft PostDraft @relation(fields: [postDraftId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

// ─────────────────────────────────────────
// PUBLISH JOB
// ─────────────────────────────────────────
model PublishJob {
  id          String @id @default(cuid())
  postDraftId String
  businessId  String

  bullmqJobId    String? @unique
  status         JobStatus @default(PENDING)
  scheduledFor   DateTime
  lockedUntil    DateTime?  // Optimistic lock to prevent double execution

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  postDraft  PostDraft       @relation(fields: [postDraftId], references: [id], onDelete: Cascade)
  attempts   PublishAttempt[]

  @@map("publish_jobs")
}

enum JobStatus {
  PENDING
  ENQUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────
// PUBLISH ATTEMPT
// ─────────────────────────────────────────
model PublishAttempt {
  id           String @id @default(cuid())
  publishJobId String

  attemptNumber Int
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  success       Boolean?
  errorCode     String?
  errorMessage  String?
  metaResponse  Json?    // Summarized Meta API response

  @@map("publish_attempts")

  publishJob PublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────
model AuditLog {
  id          String @id @default(cuid())
  businessId  String?
  adminUserId String?

  action      String  // e.g. "BATCH_UPLOADED", "POST_PUBLISHED", "TOKEN_REFRESHED"
  entityType  String? // e.g. "PostDraft", "UploadBatch"
  entityId    String?
  detail      Json?
  ipAddress   String?

  createdAt   DateTime @default(now())

  business   Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  adminUser  AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─────────────────────────────────────────
// REPORT
// Informe editorial imprimible (print-to-PDF) de un periodo de un negocio.
// El admin genera el report → snapshot KPIs + lista de posts publicados
// → URL pública /informe/[token] con CSS @media print, lista para Cmd+P.
// El token expira por defecto a los 30 días (renovable).
// ─────────────────────────────────────────
model Report {
  id         String   @id @default(cuid())
  businessId String
  token      String   @unique

  periodStart DateTime
  periodEnd   DateTime
  expiresAt   DateTime

  // Snapshot al momento de generar — para que el informe sea estable aunque
  // los posts cambien de estado luego.
  totalScheduled  Int
  totalPublished  Int
  totalFailed     Int
  successRate     Float
  // Detalle por día y por tipo guardado como JSON para evitar joins extra
  // al renderizar.
  daily      Json   // [{date, published, scheduled, failed}]
  byType     Json   // {IMAGE: n, CAROUSEL: n, REEL: n}
  topPosts   Json   // [{id, caption, type, publishedAt, permalink}]

  // Para reportes accedidos desde un front anónimo que cuenta accesos.
  viewCount  Int    @default(0)
  lastViewedAt DateTime?

  createdAt DateTime @default(now())
  createdByAdminUserId String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([token])
  @@map("reports")
}

// ─────────────────────────────────────────
// APPROVAL REQUEST (magic-link)
// Permite que un cliente apruebe/rechace un post desde un enlace mágico
// recibido por email, sin necesidad de iniciar sesión. El token es de un
// solo uso, expira en N horas (default 72) y se enlaza a un PostDraft.
// ─────────────────────────────────────────
model ApprovalRequest {
  id          String   @id @default(cuid())
  postDraftId String
  token       String   @unique
  email       String   // Email del cliente que debe aprobar

  expiresAt   DateTime
  respondedAt DateTime?
  decision    ApprovalDecision?
  feedback    String?  // Mensaje opcional del cliente (max 1000 chars)
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())
  createdByAdminUserId String?

  postDraft   PostDraft @relation(fields: [postDraftId], references: [id], onDelete: Cascade)

  @@index([postDraftId, createdAt])
  @@index([token])
  @@map("approval_requests")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────
// AI USAGE
// Telemetría de uso de Anthropic API para tracking de costes y rate-limiting
// por business. Cache hits dramáticamente reducen el coste — los tracked
// como cacheReadTokens (10% del precio normal) y cacheCreationTokens
// (125% del precio normal una sola vez).
// ─────────────────────────────────────────
model AiUsage {
  id         String @id @default(cuid())
  businessId String

  type       String   // "caption" | "hashtags"
  model      String   // "claude-sonnet-4-5", etc.

  inputTokens         Int
  outputTokens        Int
  cacheReadTokens     Int @default(0)
  cacheCreationTokens Int @default(0)

  costUsd    Float    // Computed cost in USD

  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("ai_usage")
}

// ─────────────────────────────────────────
// SYSTEM CONFIG
// Platform-level settings (Meta App credentials, etc.)
// Sensitive values are encrypted with AES-256-GCM.
// ─────────────────────────────────────────
model SystemConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String? // Plain text for non-sensitive values
  valueEnc    String? // Encrypted ciphertext
  valueIv     String? // AES-GCM IV
  valueTag    String? // AES-GCM auth tag
  isEncrypted Boolean @default(false)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}
